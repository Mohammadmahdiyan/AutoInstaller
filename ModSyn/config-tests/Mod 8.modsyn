mod {
    type: PutAndReplace
    require:
    {
        checkThese:
        [
            "cleo.asi"
            "C:\Games\GTA San Andreas\modloader"
        ]
        reqAddress: "Base Mods/CLEO"
        require:
        {
            checkThis: "modloader.asi"
            reqPath: "Base Mods/ModLoader"
        }
    }
    requires:
    [
        {
            checkThese:
            [
                "audio\Streams"
                "models\gta3.img"
            ]
            reqPath: "Base Mods/Audio and Models"
        }
    ]
    replacements:
    [
        {
            source: "data/handling.cfg"
            target: "data/handling.cfg"
        }
        {
            source: "models/vehicle.dff"
            target: "models/vehicle.dff"
        }
    ]
    backup: null
    backupThese:
    [
        "data"
        "models\vehicle.dff"
    ]
    dontBackupThese:
    [
        "audio\Config"
        "audio\SFX"
    ]
    installThese:
    [
        "data/handling.cfg"
        "models/vehicle.dff"
    ]
    ignoreThese:
    [
        "readme.txt"
        "logs/debug.txt"
    ]
}
